{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shoppinggggg-api",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-14",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGIN": "https://doristien1208.github.io"
  },
  "ratelimits": [
    { "name": "LOGIN_LIMITER", "namespace_id": "724101", "simple": { "limit": 10, "period": 60 } },
    { "name": "API_LIMITER", "namespace_id": "724102", "simple": { "limit": 60, "period": 60 } },
    { "name": "WRITE_LIMITER", "namespace_id": "724103", "simple": { "limit": 15, "period": 60 } }
  ]
}
