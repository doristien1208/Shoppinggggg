{
  "name": "shoppinggggg",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "check": "node --check site/app.js && node --check site/core.js && node --check worker/index.js",
    "dev": "python3 -m http.server 5173 --directory site",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "worker:check": "wrangler deploy --dry-run --outdir /tmp/shoppinggggg-worker-build"
  },
  "devDependencies": {
    "wrangler": "^4.150.0"
  }
}
